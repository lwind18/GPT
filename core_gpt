# -*- coding: utf-8 -*-
"""
A minimal, from-scratch implementation of the GPT-2 (124M) architecture
in PyTorch, plus a simple greedy text-generation loop.

Reference: https://github.com/vipulkoti/BuildGPT2Model/blob/main/GPT2Model.ipynb

The file is organized in five parts:
    1. Configuration
    2. Model building blocks (Embedding, PositionalEncoding, Attention,
       LayerNorm, FeedForward, TransformerBlock)
    3. The full GPT2 model that assembles the building blocks
    4. Text generation example

@author: darrenluo
"""

import math

import torch
import torch.nn as nn
from transformers import GPT2Tokenizer


# ---------------------------------------------------------------------------
# 1. Configuration
# ---------------------------------------------------------------------------
GPT_CONFIG_124M = {
    "vocab_size": 50257,     # Number of unique tokens the tokenizer can produce
    "context_length": 1024,  # Maximum sequence length the model supports
    "emb_dim": 768,          # Size of each token's embedding vector
    "n_heads": 12,           # Number of parallel attention heads
    "n_layers": 12,          # Number of stacked transformer blocks
    "drop_rate": 0.1,        # Dropout probability used throughout the model
    "qkv_bias": False,       # Whether Q/K/V linear layers include a bias term
}
# ---------------------------------------------------------------------------
# 2. Model building blocks
# ---------------------------------------------------------------------------

class Embedding(nn.Module):
    """Looks up a learned vector for each token ID."""

    def __init__(self, vocab_size, embed_size):
        super().__init__()
        self.embed = nn.Embedding(vocab_size, embed_size)

    def forward(self, x):
        # x: (batch, seq_len) token IDs -> (batch, seq_len, embed_size)
        return self.embed(x)


class PositionalEncoding(nn.Module):
    """Adds fixed sinusoidal position information to token embeddings.

    Since attention has no built-in sense of token order, we inject
    each position's identity as a sine/cosine pattern that is added
    directly to the embeddings.
    """

    def __init__(self, embed_size, max_seq_length=512):
        super().__init__()
        pe = torch.zeros(max_seq_length, embed_size)
        position = torch.arange(0, max_seq_length, dtype=torch.float).unsqueeze(1)
        div_term = torch.exp(
            torch.arange(0, embed_size, 2).float() * -(math.log(10000.0) / embed_size)
        )
        pe[:, 0::2] = torch.sin(position * div_term)  # even dims -> sine
        pe[:, 1::2] = torch.cos(position * div_term)  # odd dims -> cosine

        # Stored as a buffer: moves with the model (.to(device)) but is
        # not a trainable parameter and won't appear in state_dict grads.
        # they mark these tensors as "belongs to the model, moves with the model, saves with the model, but is never trained
        self.register_buffer("pe", pe.unsqueeze(0))  # (1, max_seq_length, embed_size)

    def forward(self, x):
        # Only use as many positions as the current sequence needs.
        return x + self.pe[:, : x.size(1)]


class MultiHeadAttention(nn.Module):
    """Scaled dot-product self-attention, computed in parallel across heads.

    GPT-2 is a *decoder-only* / autoregressive model: when predicting
    token t, it must not be allowed to look at tokens t+1, t+2, ... .
    This is enforced with a causal mask -- a lower-triangular matrix
    that blocks attention to any future position. The mask is built
    once (up to `context_length`) and cached as a buffer so it doesn't
    need to be rebuilt on every forward pass.
    """

    def __init__(self, embed_size, num_heads, context_length, qkv_bias=False):
        super().__init__()
        self.embed_size = embed_size
        self.num_heads = num_heads
        self.head_dim = embed_size // num_heads

        self.query = nn.Linear(embed_size, embed_size, bias=qkv_bias)
        self.key   = nn.Linear(embed_size, embed_size, bias=qkv_bias)
        self.value = nn.Linear(embed_size, embed_size, bias=qkv_bias)
        self.out   = nn.Linear(embed_size, embed_size)

        # causal_mask[i, j] == True means "position i may NOT attend to
        # position j" (j is strictly in the future relative to i).
        causal_mask = torch.triu(torch.ones(context_length, context_length), diagonal=1).bool()
        self.register_buffer("causal_mask", causal_mask)

    def forward(self, x, padding_mask=None):
        batch_size, seq_len, _ = x.shape

        # Project inputs to Q/K/V, then split into (num_heads, head_dim)
        # and move the head dimension next to batch for parallel matmuls.
        q = self.query(x).view(batch_size, -1, self.num_heads, self.head_dim).transpose(1, 2)
        k = self.key(x).view(batch_size, -1, self.num_heads, self.head_dim).transpose(1, 2)
        v = self.value(x).view(batch_size, -1, self.num_heads, self.head_dim).transpose(1, 2)

        # Scaled dot-product attention scores: (batch, heads, seq, seq)
        attention = torch.matmul(q, k.transpose(-1, -2)) / math.sqrt(self.head_dim)

        # Always apply the causal mask, cropped to the current sequence length.
        attention = attention.masked_fill(self.causal_mask[:seq_len, :seq_len], float("-inf"))

        # Optionally also block attention to padding tokens.
        # padding_mask: (batch, seq_len), True/1 = "real token", False/0 = "padding".
        if padding_mask is not None:
            pad = padding_mask[:, None, None, :] == 0  # -> (batch, 1, 1, seq_len) -> insert a new dimension here
            attention = attention.masked_fill(pad, float("-inf"))

        attention = torch.softmax(attention, dim=-1)

        # Weighted sum of values, then merge heads back into one vector.
        out = torch.matmul(attention, v)
        out = out.transpose(1, 2).contiguous().view(batch_size, -1, self.embed_size)
        return self.out(out)


class LayerNorm(nn.Module):
    """Manual LayerNorm implementation, kept for reference/teaching purposes.

    The actual model below uses PyTorch's built-in `nn.LayerNorm`, which
    is equivalent but more optimized. This class shows what happens
    under the hood: normalize to mean 0 / variance 1, then apply a
    learned scale and shift.
    """

    def __init__(self, emb_dim, eps=1e-5):
        super().__init__()
        self.eps = eps
        self.scale = nn.Parameter(torch.ones(emb_dim))
        self.shift = nn.Parameter(torch.zeros(emb_dim))

    def forward(self, x):
        mean = x.mean(dim=-1, keepdim=True)
        var = x.var(dim=-1, keepdim=True, unbiased=False)
        norm_x = (x - mean) / torch.sqrt(var + self.eps)
        return self.scale * norm_x + self.shift


class FeedForward(nn.Module):
    """Position-wise MLP applied identically to every token: expand, then project back."""

    def __init__(self, embed_size, ff_hidden_size):
        super().__init__()
        self.fc1 = nn.Linear(embed_size, ff_hidden_size)
        self.fc2 = nn.Linear(ff_hidden_size, embed_size)
        self.gelu = nn.GELU()

    def forward(self, x):
        return self.fc2(self.gelu(self.fc1(x)))


class TransformerBlock(nn.Module):
    """One GPT-2 layer: self-attention + feed-forward, each with a
    residual connection and layer normalization.
    """

    def __init__(self, embed_size, num_heads, context_length, ff_hidden_size, dropout=0.1, qkv_bias=False):
        super().__init__()
        self.mha = MultiHeadAttention(embed_size, num_heads, context_length, qkv_bias)
        self.ff = FeedForward(embed_size, ff_hidden_size)
        self.ln1 = nn.LayerNorm(embed_size)
        self.ln2 = nn.LayerNorm(embed_size)
        self.dropout = nn.Dropout(dropout)

    def forward(self, x, padding_mask=None):
        # Attention sub-layer: residual add, then normalize.
        # (Causal masking happens automatically inside self.mha.)
        x = x + self.dropout(self.mha(self.ln1(x), padding_mask))
        # Feed-forward sub-layer: residual add, then normalize.
        x = x + self.dropout(self.ff(self.ln2(x)))
        return x

# ---------------------------------------------------------------------------
# 3. Full GPT-2 model
# ---------------------------------------------------------------------------

class GPT2(nn.Module):
    """Stacks embeddings + positional encoding + N transformer blocks,
    then projects back to vocabulary-sized logits.
    """

    def __init__(self, config):
        super().__init__()
        self.embedding = Embedding(config["vocab_size"], config["emb_dim"])
        self.positional_encoding = PositionalEncoding(config["emb_dim"], config["context_length"])

        self.transformer_blocks = nn.ModuleList([
            TransformerBlock(
                config["emb_dim"],
                config["n_heads"],
                config["context_length"],
                config["emb_dim"] * 4,
                config["drop_rate"],
                config["qkv_bias"],
            )
            for _ in range(config["n_layers"])
        ])

        self.fc_out = nn.Linear(config["emb_dim"], config["vocab_size"])
        self.dropout = nn.Dropout(config["drop_rate"])

    def forward(self, x, padding_mask=None):
        # 1. Token IDs -> embeddings -> add positional info
        x = self.dropout(self.positional_encoding(self.embedding(x)))

        # 2. Pass through every transformer block in sequence.
        # Causal masking (no peeking at future tokens) is applied
        # automatically inside each block's attention layer.
        for block in self.transformer_blocks:
            x = block(x, padding_mask)

        # 3. Project to vocabulary size to get next-token logits
        return self.fc_out(x)  # (batch, seq_len, vocab_size)

# ---------------------------------------------------------------------------
# 4. Text generation
# ---------------------------------------------------------------------------
def generate_text_with_temperature(model, idx, max_new_tokens, context_size, temperature=1.0):
    """  Parameters
    ----------
    model : GPT2
        The trained (or, here, randomly initialized) language model.
    idx : torch.Tensor, shape (batch, n_tokens)
        Token IDs for the current context.
    max_new_tokens : int
        How many new tokens to generate.
    context_size : int
        Maximum number of tokens the model can attend to; longer
        contexts are truncated from the left before each forward pass.
    temperature < 1.0 -> more focused/deterministic (closer to greedy)
    temperature = 1.0 -> unscaled softmax (unbiased sampling)
    temperature > 1.0 -> more random/diverse (flatter distribution)
    Returns
    -------
    torch.Tensor, shape (batch, n_tokens + max_new_tokens)
        The original context extended with the newly generated tokens.
    """
    for _ in range(max_new_tokens):
        idx_cond = idx[:, -context_size:]

        with torch.no_grad():
            logits = model(idx_cond)

        logits = logits[:, -1, :]                     # (batch, vocab_size)

        # --- this is the only change from generate_text_simple ---
        logits = logits / temperature                 # scale before softmax
        probas = torch.softmax(logits, dim=-1)         # (batch, vocab_size)
        idx_next = torch.multinomial(probas, num_samples=1)  # sample, not argmax
        # -----------------------------------------------------------

        idx = torch.cat((idx, idx_next), dim=1)

    return idx
